// Gameplay numbers for Scroller. On desktop, edits are picked up while the
// game is running. The web build uses the values committed here.
(
    // Lives: start with 3, extra life at 20,000 and every 50,000 after, max 5.
    starting_lives: 3,
    max_lives: 5,
    first_extra_life: 20000,
    extra_life_every: 50000,

    // Seconds before Attract Mode flips between the title and High Score Table.
    attract_panel_seconds: 8.0,

    // Developer keys: K loses a life, P adds 1000 points, C clears the Stage,
    // F2 shows the sprite sheet. Off for players: `cargo run` (a dev build)
    // forces them on, and on the web `?debug` in the URL turns them on.
    debug_keys: false,
    // Debug aids, only with debug_keys on: a Hero nothing can hit, and a game
    // speed multiplier during Stages (2.0 = twice as fast). In the browser,
    // `?invincible&time_scale=8` on the URL overrides these.
    invincible_hero: false,
    time_scale: 1.0,

    // The shared gameplay kit every Cabinet uses.
    kit: (
        invulnerable_seconds: 2.0, // blinking after reappearing at a Restart Point
        hit_flash_seconds: 0.06,
        explosion_particles: 10,
        explosion_speed: 70.0,     // pixels per second
        explosion_seconds: 0.5,
        shake_on_hero_down: 0.7,   // 0 to 1
        shake_max_offset: 4.0,     // pixels at full shake
        shake_decay: 1.5,          // per second
    ),

    // The stand-in Cabinet used until the real Cabinets are built.
    // Its Stage layout is in assets/stages/placeholder-*.ron.
    placeholder: (
        hero_speed: 90.0,
        shot_speed: 240.0,
        fire_seconds: 0.18,
        drone_speed: 50.0,
        drone_health: 2,
        drone_score: 100,
        gunner_fire_seconds: 1.6,
        enemy_shot_speed: 90.0,
    ),

    // Cabinet 1, the side-scrolling shooter. Every key is explained in
    // docs/cabinets/1-side-shooter.md.
    side_shooter: (
        stage2_bullet_speed_scale: 1.15,
        // Debug: play every enemy type in turn instead of Stage 1 (needs
        // debug_keys). `?gallery` on the web URL does the same.
        enemy_gallery: false,
        enemy: (
            bullet_size: (5.0, 5.0), bullet_hitbox: (2.0, 2.0), hitbox_inset: 1.0,
            fire_grace_seconds: 0.5, min_fire_distance: 40.0, max_bullets: 40,
            no_spawn_radius: 48.0, bullet_lifetime: 12.0,
        ),
        enemies: (
            skiff: (hp: 1, score: 100, formation_size: 5, v_spacing: (12.0, 10.0),
                    speed: 90.0, peel_x: 40.0, peel_interval: 0.15, peel_turn_rate: 180.0,
                    exit_speed: 140.0, launched_speed: 120.0),
            gull: (hp: 1, score: 100, formation_size: 6, spacing_seconds: 0.25,
                   speed: 70.0, amplitude: 28.0, period: 1.6, shot_speed: 80.0, fire_x: 0.0),
            bellbuoy: (hp: 10, score: 300, wave_y: -104.0, bob_amplitude: 2.0, bob_period: 1.4,
                       trigger_range: 80.0, telegraph_seconds: 0.4, fan_count: 3,
                       fan_degrees: 15.0, shot_speed: 90.0, cooldown: 2.0),
            lamplighter: (hp: 36, score: 500, speed: 80.0, brake_distance: 24.0, brake_floor: 0.15, stop_x: 100.0,
                          hover_seconds: 3.0, bob_amplitude: 2.0, bob_period: 1.5,
                          telegraph_seconds: 0.4, shots: 3, shot_speed: 100.0,
                          fire_interval: 1.0, exit_speed: 80.0),
            hook: (hp: 2, score: 200, formation_size: 2, warning_seconds: 0.75, chevron_blink_hz: 4.0, speed: 150.0,
                   pass_offset: 50.0, terrain_clearance: 12.0, turn_x: 110.0,
                   turn_radius: 14.0, charge_speed: 170.0,
                   charge_steer_speed: 85.0, pair_spread: 0.5),
            ferry: (hp: 360, hp_stage2: 640, score: 2000, speed: 25.0, hold_x: 60.0,
                    hold_seconds: 18.0, sink_speed: 20.0,
                    launch_count: 2, launch_offset: (-12.0, 10.0), first_launch_delay: 1.0, launch_interval: 3.0,
                    ring_count: 8, ring_speed: 70.0, first_ring_delay: 2.0, ring_interval: 2.5),
            barnacle: (hp: 10, score: 400, turn_rate: 120.0, telegraph_seconds: 0.3,
                       shot_speed: 110.0, fire_interval: 1.3),
            clam: (hp: 14, score: 800, formation_size: 2, pair_spacing: (0.0, -48.0),
                   bob_amplitude: 3.0, bob_period: 2.0, closed_seconds: 2.0, open_seconds: 1.0,
                   fan_count: 5, fan_degrees: 60.0, shot_speed: 100.0),
            mote: (hp: 1, score: 50, formation_size: 10, cloud_radius: 40.0, speed: 65.0,
                   turn_rate: 90.0, lifetime: 8.0),
            arc_gate: (hp: 40, score: 600, arc_width: 4.0, on_seconds: 1.2, off_seconds: 0.8,
                       telegraph_seconds: 0.3),
        ),
        hero: (
            hitbox: (4.0, 4.0), terrain_hitbox: (12.0, 6.0),
            speed: 100.0, speed_step: 20.0, edge_margin: 4.0,
            start: (-110.0, 0.0), entry_from_x: -176.0, entry_seconds: 1.0,
            respawn_invulnerable_seconds: 2.0, hit_stop_seconds: 0.15,
        ),
        shot: (
            fire_interval: 0.125, speed: 360.0, damage: 1, size: (8.0, 2.0),
            twin_spacing: 6.0, spread_degrees: 10.0,
            lance_size: (12.0, 3.0), lance_damage: 2,
            tail_every: 2, drone_every: 2, max_on_screen: 96,
        ),
        bomb: (starting: 2, max: 4, ring_speed: 420.0, damage: 12, invulnerable_seconds: 1.0),
        power_up: (
            size: (10.0, 10.0), pickup_box: (14.0, 14.0), edge_inset: 16.0,
            drift_speed: 30.0, bob_amplitude: 3.0, bob_period: 1.2,
            gun_max: 4, drone_max: 2, drone_offset: 14.0, speed_max: 2,
            ward_invulnerable_seconds: 1.0, ward_push: 8.0,
        ),
        terrain: (tile_size: 8.0, min_gap: 72.0, hook_min_gap: 120.0),
        score: (formation_bonus_per_enemy: 100, maxed_power_up: 1000, bomb_cancel: 10,
                stage_clear: 3000, no_miss: 5000),
    ),
    // Cabinet 2: SPIREWARD (docs/cabinets/2-vertical-shooter.md).
    // Debug: play the enemy gallery instead of the Stage (needs debug_keys).
    // `?gallery` on the web URL does the same.
    vertical_shooter: (
        enemy_gallery: false,
        stage2_bullet_speed_scale: 1.15,
        look: (shadow_offset: (6.0, -6.0)),
        hero: (
            hitbox: (4.0, 4.0), speed: 100.0, speed_step: 20.0, edge_margin: 4.0,
            start: (0.0, -80.0), entry_from_y: -136.0, entry_seconds: 1.0,
            respawn_invulnerable_seconds: 2.0, hit_stop_seconds: 0.15,
        ),
        shot: (
            fire_interval: 0.1, speed: 360.0, damage: 1, size: (2.0, 8.0),
            twin_spacing: 6.0, spread_degrees: 15.0,
            lance_size: (3.0, 12.0), lance_damage: 2, max_on_screen: 96,
        ),
        rocket: (count: 2, interval: 0.5, launch_offset: (5.0, 0.0), size: (3.0, 6.0),
                 speed: 200.0, turn_rate: 270.0, damage: 3),
        bomb: (starting: 2, max: 4, band_speed: 420.0, damage: 12, invulnerable_seconds: 1.0),
        power_up: (
            size: (10.0, 10.0), pickup_box: (14.0, 14.0), edge_inset: 16.0,
            drift_speed: 30.0, bob_amplitude: 3.0, bob_period: 1.2,
            gun_max: 4, pod_max: 2, pod_offset: 14.0, speed_max: 2,
            ward_invulnerable_seconds: 1.0,
        ),
        enemy: (
            bullet_size: (5.0, 5.0), bullet_hitbox: (2.0, 2.0), hitbox_inset: 1.0,
            fire_grace_seconds: 0.5, min_fire_distance: 40.0, max_bullets: 40,
            no_spawn_radius: 48.0, bullet_lifetime: 12.0,
        ),
        enemies: (
            wisp: (hp: 1, score: 100, formation_size: 6, spacing_seconds: 0.3, speed: 80.0,
                   turn_y: 20.0, turn_rate: 150.0, exit_speed: 110.0, launched_speed: 100.0),
            swift: (hp: 2, score: 200, formation_size: 2, warning_seconds: 0.75,
                    chevron_blink_hz: 4.0, speed: 150.0, pass_offset: 50.0, pair_spread: 0.5,
                    edge_clearance: 12.0, turn_y: 80.0, turn_radius: 14.0,
                    dive_speed: 170.0, dive_steer_speed: 85.0),
            bellows: (hp: 36, score: 500, speed: 80.0, brake_distance: 24.0, brake_floor: 0.15,
                      stop_inset: 60.0, hover_seconds: 3.0, sway_amplitude: 2.0, sway_period: 1.5,
                      telegraph_seconds: 0.4, burst: 3, burst_interval: 0.12, bursts: 2,
                      fire_interval: 1.4, shot_speed: 90.0, exit_speed: 80.0),
            loom: (shuttle_hp: 60, shuttle_hp_stage2: 100, shuttle_score: 500,
                   core_hp: 240, core_hp_stage2: 400, core_score: 2000,
                   shuttle_offset: 28.0, speed: 20.0, hold_y: 60.0, hold_seconds: 20.0,
                   retreat_speed: 20.0,
                   first_launch_delay: 1.0, launch_interval: 3.0,
                   telegraph_seconds: 0.4, pair_interval: 0.15, shot_speed: 80.0,
                   fire_interval: 2.5,
                   spiral_arms: 3, spiral_interval: 0.3, spiral_turn_rate: 40.0,
                   spiral_speed: 60.0, spiral_seconds: 2.0, spiral_pause: 2.0),
            crawler: (hp: 10, score: 300, formation_size: 3, spacing: 18.0, speed: 12.0,
                      turn_rate: 120.0, telegraph_seconds: 0.3, shot_speed: 80.0,
                      fire_interval: 2.0, stagger: 0.4),
            silo: (hp: 16, score: 800, closed_seconds: 2.4, telegraph_seconds: 0.3,
                   open_seconds: 1.2, ring_count: 6, shot_speed: 70.0),
            riser: (hp: 16, score: 400, first_launch_delay: 1.0, launch_interval: 3.5,
                    climb_seconds: 1.0, pod_score_climbing: 150, pod_score_airborne: 50,
                    drift_speed: 40.0, fuse_seconds: 1.2, telegraph_seconds: 0.3,
                    ring_count: 6, shot_speed: 70.0),
            flak: (hp: 24, score: 600, fire_interval: 2.4, warning_seconds: 0.6,
                   burst_radius: 10.0, burst_seconds: 0.15, burst_count: 6,
                   burst_speed: 60.0, max_on_screen: 2),
            mote: (hp: 1, score: 50, formation_size: 10, cloud_radius: 40.0, speed: 65.0,
                   turn_rate: 90.0, lifetime: 8.0),
            tether: (hp: 40, score: 600, line_width: 4.0, on_seconds: 1.2, off_seconds: 0.8,
                     telegraph_seconds: 0.3),
        ),
        score: (formation_bonus_per_enemy: 100, maxed_power_up: 1000, bomb_cancel: 10,
                stage_clear: 3000, no_miss: 5000),
    ),
    // Cabinet 3: UNDERFIELD (docs/cabinets/3-run-and-gun.md).
    // Debug (need debug_keys): `?gallery` plays the enemy gallery, and
    // `?autopilot` makes the Hero run, fire and jump by itself.
    run_and_gun: (
        enemy_gallery: false,
        stage2_bullet_speed_scale: 1.15,
        debug_autopilot: false,
        camera: (push_x: -16.0, max_x: 64.0),
        hero: (
            hitbox: (6.0, 14.0), crouch_hitbox: (6.0, 8.0),
            body: (10.0, 20.0), crouch_body: (10.0, 12.0),
            run_speed: 72.0, air_speed: 72.0, edge_margin: 4.0,
            entry_from_y: 132.0, exit_seconds: 1.0,
            respawn_invulnerable_seconds: 2.0, hit_stop_seconds: 0.15,
        ),
        jump: (
            speed: 240.0, gravity_up: 600.0, gravity_down: 900.0, cut: 0.4,
            max_fall: 300.0, coyote_seconds: 0.08, buffer_seconds: 0.1,
        ),
        shot: (
            fire_interval: 0.125, fire_interval_fast: 0.083, speed: 300.0, damage: 1,
            size: (6.0, 2.0), muzzle: (8.0, 14.0), crouch_muzzle: (8.0, 6.0),
            spread_degrees: 12.0,
            bolt_size: (10.0, 3.0), bolt_damage: 2, max_on_screen: 64,
        ),
        flare: (interval: 0.8, size: (4.0, 4.0), launch: (110.0, 160.0),
                damage: 4, radius: 12.0, max_on_screen: 3),
        power_up: (
            size: (10.0, 10.0), bob_amplitude: 2.0, bob_period: 1.0,
            gun_max: 4, jet_speed_fraction: 0.7, hustle_step: 12.0,
            ward_invulnerable_seconds: 1.0,
        ),
        terrain: (tile_size: 8.0, max_gap: 40.0, max_step: 40.0, crumble_seconds: 0.5,
                  crumble_respawn_seconds: 3.0,
                  // Stage-check constants (read by stage_checks.rs only):
                  restart_pit_clearance: 48.0, restart_hazard_clearance: 48.0,
                  pit_free_run: 64.0),
        enemy: (
            bullet_size: (5.0, 5.0), bullet_hitbox: (2.0, 2.0), hitbox_inset: 1.0,
            fire_grace_seconds: 0.5, min_fire_distance: 40.0, max_bullets: 32,
            no_spawn_radius: 48.0, bullet_lifetime: 10.0, behind_warning_seconds: 0.75,
            chest_height: 14.0, ankle_height: 4.0, aimed_min_distance: 64.0,
        ),
        enemies: (
            skitter: (hp: 2, score: 100, formation_size: 4, spacing: 16.0, speed: 60.0,
                      max_hop: 24.0, hop_height: 20.0),
            tick: (hp: 6, score: 200, formation_size: 2, hop_height: 24.0, hop_length: 32.0,
                   rest_seconds: 0.6, stagger: 0.3, telegraph_seconds: 0.25),
            kite: (hp: 2, score: 150, formation_size: 3, spacing_seconds: 0.4, cruise_y: 80.0,
                   speed: 70.0, dive_window: 40.0, telegraph_seconds: 0.3, dive_floor: 14.0,
                   dive_speed: 130.0),
            sentry: (hp: 14, score: 500, down_seconds: 1.8, telegraph_seconds: 0.3,
                     up_seconds: 1.4, burst: 2, burst_interval: 0.25, shot_speed: 60.0),
            burrower: (hp: 6, score: 300, wake_distance: 72.0, telegraph_seconds: 0.4,
                       shot_speed: 60.0, fire_interval: 1.6, up_seconds: 3.2, down_seconds: 2.0),
            dropper: (hp: 20, score: 400, cruise_y: 72.0, speed: 40.0, fire_interval: 1.5,
                      telegraph_seconds: 0.4, canister_gravity: 600.0, burst_speed: 60.0,
                      no_drop_window: 24.0, canister_size: (8.0, 8.0)),
            hauler: (hp: 40, score: 800, speed: 20.0, plough_height: 10.0, fire_interval: 2.4,
                     telegraph_seconds: 0.4, fan_count: 3, fan_degrees: 50.0, shot_speed: 60.0,
                     shot_gravity: 120.0),
            turret: (hp: 24, score: 400, turn_rate: 90.0, fire_interval: 2.0,
                     telegraph_seconds: 0.35, shot_speed: 60.0),
            mote: (hp: 1, score: 50, formation_size: 8, cloud_radius: 32.0, speed: 55.0,
                   turn_rate: 90.0, lifetime: 8.0),
            strider: (hp: 120, score: 5000, speed: 16.0, hold_x: 72.0, pace_range: 40.0,
                      core_height: 16.0, cycle_seconds: 4.0, wave_range: 120.0, fan_delay: 2.2,
                      stomp_telegraph_seconds: 0.6, wave_height: 8.0,
                      wave_speed: 90.0, fan_count: 5, fan_degrees: 40.0, shot_speed: 60.0,
                      telegraph_seconds: 0.4),
        ),
        hazards: (
            crusher: (up_seconds: 1.6, telegraph_seconds: 0.5, slam_seconds: 0.15,
                      down_seconds: 0.6),
            arc_floor: (on_seconds: 1.0, off_seconds: 1.4, telegraph_seconds: 0.4),
            conveyor: (speed: 24.0),
        ),
        score: (formation_bonus_per_enemy: 100, maxed_power_up: 1000,
                standoff_time_bonus: 50, stage_clear: 3000, no_miss: 5000),
    ),
    // Cabinet 4: HIGHWIRE (docs/cabinets/4-climber.md).
    climber: (
        stage2_bullet_speed_scale: 1.15,
        debug_autopilot: false,
        camera: (face_half_width: 128.0),
        hero: (
            hitbox: (6.0, 14.0), crouch_hitbox: (6.0, 8.0),
            body: (10.0, 20.0), crouch_body: (10.0, 12.0),
            run_speed: 72.0, air_speed: 72.0,
            respawn_fall_speed: 60.0, fall_line: -120.0, exit_seconds: 1.0,
            respawn_invulnerable_seconds: 2.0, hit_stop_seconds: 0.15,
        ),
        jump: (
            speed: 240.0, gravity_up: 600.0, gravity_down: 900.0, cut: 0.4,
            max_fall: 300.0, coyote_seconds: 0.08, buffer_seconds: 0.1,
        ),
        ladder: (climb_speed: 48.0, grab_window: 6.0, jump_speed_fraction: 0.6),
        shot: (
            fire_interval: 0.125, fire_interval_fast: 0.1, speed: 300.0, damage: 1,
            size: (6.0, 2.0), muzzle: (8.0, 14.0), crouch_muzzle: (8.0, 6.0),
            spread_degrees: 12.0, bolt_size: (10.0, 3.0), bolt_damage: 2, max_on_screen: 64,
        ),
        power_up: (
            size: (10.0, 10.0), bob_amplitude: 2.0, bob_period: 1.0,
            gun_max: 4, jet_speed_fraction: 0.7, canopy_fall_speed: 50.0,
            mag_crumble_factor: 2.0, ward_invulnerable_seconds: 1.0,
        ),
        terrain: (
            tile_size: 8.0, crumble_seconds: 0.5, crumble_respawn_seconds: 3.0,
            // Stage-check constants (read by stage_checks.rs only):
            max_rise: 40.0, max_gap: 40.0, jump_setup_seconds: 0.3, drop_margin: 48.0,
            lookahead: 16.0, restart_clear_rise: 64.0,
        ),
        enemy: (
            bullet_size: (5.0, 5.0), bullet_hitbox: (2.0, 2.0), hitbox_inset: 1.0,
            fire_grace_seconds: 0.5, min_fire_distance: 40.0, max_bullets: 32,
            no_spawn_radius: 48.0, bullet_lifetime: 10.0, below_warning_seconds: 0.75,
            chest_height: 14.0, ankle_height: 4.0,
        ),
        enemies: (
            flit: (hp: 2, score: 100, formation_size: 3, spacing_seconds: 0.4, speed: 60.0,
                   wave_amplitude: 12.0, wave_period: 1.2),
            limpet: (hp: 2, score: 100, formation_size: 2, speed: 24.0),
            scrap: (hp: 2, score: 50, warning_seconds: 0.75, speed: 120.0,
                    fall_interval: 0.8, min_spacing: 24.0),
            picket: (hp: 16, score: 500, speed: 20.0, level_window: 16.0,
                     telegraph_seconds: 0.35, burst: 2, burst_interval: 0.25,
                     shot_speed: 60.0, cooldown_seconds: 2.0),
            vent: (hp: 12, score: 500, closed_seconds: 2.2, telegraph_seconds: 0.3,
                   open_seconds: 1.4, fan_count: 3, fan_degrees: 30.0, shot_speed: 55.0),
            plumb: (hp: 6, score: 300, drop_speed: 60.0, hang_seconds: 2.0,
                    telegraph_seconds: 0.3, shot_speed: 60.0, reel_speed: 40.0),
            pitcher: (hp: 20, score: 400, range: 120.0, fire_interval: 2.4,
                      telegraph_seconds: 0.4, canister_size: (8.0, 8.0), launch_speed: 60.0,
                      canister_gravity: 300.0, burst_speed: 50.0),
            mote: (hp: 1, score: 50, formation_size: 8, cloud_radius: 32.0, speed: 55.0,
                   turn_rate: 90.0, lifetime: 8.0),
            winch: (hp: 120, score: 5000, rail_y: 80.0, speed: 40.0,
                    telegraph_seconds: 0.6, drop_speed: 200.0, burst_speed: 60.0,
                    rest_seconds: 1.2, reel_speed: 80.0),
        ),
        hazards: (
            gust: (blow_seconds: 2.0, push_speed: 36.0, warning_seconds: 0.8),
            sweeper: (length: 48.0, turn_rate: 60.0),
        ),
        score: (formation_bonus_per_enemy: 100, maxed_power_up: 1000,
                standoff_time_bonus: 50, stage_clear: 3000, no_miss: 5000),
    ),
)
