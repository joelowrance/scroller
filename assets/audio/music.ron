    // "The Crown Rise" (Cabinet 4, Stage 2 run-out): original. 144 BPM, C major, 12 bars (20 s), builds to a held chord that hands over to the Ending. Plays once.
    CrownRise: (
        bpm: 144,
        rows_per_beat: 4,
        looping: false,
        channels: [
            // Lead
            (instrument: (wave: Square(duty: 0.25), volume: 0.16,
                          env: (attack: 0.005, decay: 0.10, sustain: 0.55, release: 0.05),
                          vibrato: (depth: 0.1, rate: 6.0))),
