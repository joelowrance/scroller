    // "Crown" (Cabinet 4, Stage 2): original. 144 BPM, A minor, then the relative major (C) as dawn comes in.
    Crown: (
        bpm: 144,
        rows_per_beat: 4,
        channels: [
            // Lead
            (instrument: (wave: Square(duty: 0.25), volume: 0.16,
                          env: (attack: 0.005, decay: 0.10, sustain: 0.55, release: 0.05),
                          vibrato: (depth: 0.1, rate: 6.0))),
            // The climbing arpeggio: sixteenths
            (instrument: (wave: Square(duty: 0.125), volume: 0.09,
                          env: (decay: 0.05, sustain: 0.2, release: 0.01))),
            // Bass: octave bounce
            (instrument: (wave: Triangle, volume: 0.38,
                          env: (decay: 0.12, sustain: 0.4, release: 0.02))),
            // Drums
            (kit: {
                "k": (freq: 120, gate: 0.11, instrument: (wave: Triangle, volume: 0.36, slide: -26,
                      env: (decay: 0.11, sustain: 0.0, release: 0.01))),
                "s": (freq: 4200, gate: 0.09, instrument: (wave: Noise, volume: 0.20,
                      env: (decay: 0.09, sustain: 0.0, release: 0.02))),
                "h": (freq: 14000, gate: 0.02, instrument: (wave: Noise, volume: 0.09,
                      env: (decay: 0.02, sustain: 0.0, release: 0.01))),
