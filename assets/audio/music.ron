    // "Bail Out": original. The 2 -> 3 Cabinet Transition sting, about 5.5 s.
    // Starts on Cabinet 2's C minor siren, the hit lands with a crash, a
    // falling line through Ab and G, then the slow, lonely A minor of
    // Cabinet 3 as the Hero lands. 120 BPM, Cabinet 3's tempo. Plays once.
    BailOut: (
        bpm: 120,
        rows_per_beat: 4,
        looping: false,
        channels: [
            // Lead
            (instrument: (wave: Square(duty: 0.25), volume: 0.18,
                          env: (attack: 0.01, decay: 0.2, sustain: 0.6, release: 0.35),
                          vibrato: (depth: 0.25, rate: 5.0))),
            // Counter-line
            (instrument: (wave: Square(duty: 0.125), volume: 0.08,
                          env: (decay: 0.08, sustain: 0.4, release: 0.30))),
            // Bass
            (instrument: (wave: Triangle, volume: 0.30,
                          env: (decay: 0.1, sustain: 0.7, release: 0.30))),
            // Drums
            (kit: {
                "k": (freq: 120, gate: 0.12, instrument: (wave: Triangle, volume: 0.34, slide: -30,
                      env: (decay: 0.12, sustain: 0.0, release: 0.01))),
                "h": (freq: 12000, gate: 0.03, instrument: (wave: Noise, volume: 0.10,
                      env: (decay: 0.03, sustain: 0.0, release: 0.01))),
                "c": (freq: 7000, gate: 0.9, instrument: (wave: Noise, volume: 0.16,
                      env: (decay: 0.9, sustain: 0.0, release: 0.1))),
            }),
        ],
        patterns: {
        "hit": [ // Cm siren, then the hit
            "C6 Eb6 C6 Eb6 G5 - - - F5 - Eb5 - D5 - C5 -",
            "C5 G4 C5 G4 . . . . Ab4 - - - G4 - - -",
            "C3 C3 C3 C3 C2 - - - - - - - - - - -",
            "h h h h k . c . . . . . k . . .",
        ],
        "fall": [ // Ab, G
            "Bb4 - Ab4 - G4 - F4 - Eb4 - D4 - - - B3 -",
            "Eb4 C4 Eb4 C4 Eb4 C4 Eb4 C4 D4 B3 D4 B3 D4 B3 D4 B3",
            "Ab2 - - - Ab2 - - - G2 - - - G2 - - -",
            "k . . . . . . . k . . . . . h .",
        ],
        "land": [ // Am, ringing out
            "A4 - - - C5 - E5 - - - - - . . . .",
            "E4 - A4 - - - - - - - - - . . . .",
            "A2 - - - E2 - A2 - - - - - . . . .",
            "k . . . k . c . . . . . . . . .",
        ],
        },
        order: ["hit", "fall", "land"],
    ),

    // "Footings" (Cabinet 4, Stage 1): original. F# minor, 112 BPM, night.
    Footings: (
        bpm: 112,
        rows_per_beat: 4,
        channels: [
            // Lead: high, sparse
            (instrument: (wave: Square(duty: 0.25), volume: 0.15,
                          env: (attack: 0.01, decay: 0.3, sustain: 0.5, release: 0.2),
                          vibrato: (depth: 0.12, rate: 5.0))),
            // The climbing arpeggio: steady eighths, rising each bar
            (instrument: (wave: Square(duty: 0.125), volume: 0.11,
                          env: (decay: 0.10, sustain: 0.25, release: 0.02))),
            // Drone
            (instrument: (wave: Triangle, volume: 0.36,
                          env: (attack: 0.03, decay: 0.3, sustain: 0.8, release: 0.05))),
            // Drums: soft
            (kit: {
                "k": (freq: 110, gate: 0.10, instrument: (wave: Triangle, volume: 0.28, slide: -24,
                      env: (decay: 0.10, sustain: 0.0, release: 0.01))),
                "r": (freq: 3200, gate: 0.04, instrument: (wave: Noise, volume: 0.10,
                      env: (decay: 0.04, sustain: 0.0, release: 0.01))),
                "h": (freq: 12000, gate: 0.015, instrument: (wave: Noise, volume: 0.06,
                      env: (decay: 0.015, sustain: 0.0, release: 0.01))),
            }),
        ],
        patterns: {
            "intro": [
                ". . . . . . . . . . . . . . . .",
                "F#3 - A3 - C#4 - F#4 - A4 - C#5 - F#5 - A5 -",
                "F#2 - - - - - - - - - - - - - - -",
                ". . . . . . . . . . . . . . . .",
            ],
            "a1": [
