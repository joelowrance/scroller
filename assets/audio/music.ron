// Songs for the sequencer in src/audio/music.rs, rendered at start-up.
//
// Every pattern gives one line per channel (in the order the song lists its
// channels), one whitespace-separated token per row: a note (C4, F#3, Bb5) starts a note,
// "-" holds it, "." rests, and a kit key plays that drum. Instruments take
// the same fields as a sound-effect tone (wave, env, slide, vibrato, volume).
// A song loops unless it says `looping: false`.
{
    // "Neon Overture": original. A minor, 140 bpm, sixteenth-note rows.
    Title: (
        bpm: 140,
        rows_per_beat: 4,
        channels: [
            // Lead
            (instrument: (wave: Square(duty: 0.25), volume: 0.24,
                          env: (attack: 0.005, decay: 0.12, sustain: 0.6, release: 0.05),
                          vibrato: (depth: 0.15, rate: 6.0))),
            // Arpeggio
            (instrument: (wave: Square(duty: 0.125), volume: 0.10,
                          env: (decay: 0.06, sustain: 0.25, release: 0.02))),
            // Bass
            (instrument: (wave: Triangle, volume: 0.36,
                          env: (decay: 0.1, sustain: 0.7, release: 0.02))),
            // Drums
            (kit: {
                "k": (freq: 160, gate: 0.09, instrument: (wave: Triangle, volume: 0.34, slide: -24,
                      env: (decay: 0.09, sustain: 0.0, release: 0.01))),
                "s": (freq: 5000, gate: 0.10, instrument: (wave: Noise, volume: 0.22,
                      env: (decay: 0.10, sustain: 0.0, release: 0.02))),
                "h": (freq: 14000, gate: 0.025, instrument: (wave: Noise, volume: 0.12,
                      env: (decay: 0.025, sustain: 0.0, release: 0.01))),
            }),
        ],
        patterns: {
        "intro": [ // Am
            ". . . . . . . . . . . . . . . .",
            ". . . . . . . . . . . . . . . .",
            "A2 - A3 - A2 - A3 - A2 - A3 - A2 - A3 -",
            "k . h . . . h . k . h . . . h .",
        ],
        "intro2": [ // Am
            ". . . . . . . . . . . . . . . .",
            ". . . . . . . . . . . . . . . .",
            "A2 - A3 - A2 - A3 - A2 - A3 - A2 - A3 -",
            "k . s . s . s s s s . s s s s s",
        ],
        "a1": [ // Am
            "E5 - - - A5 - - - G5 - E5 - D5 - C5 -",
            "A4 C5 E5 C5 A4 C5 E5 C5 A4 C5 E5 C5 A4 C5 E5 C5",
            "A2 - A3 - A2 - A3 - A2 - A3 - A2 - A3 -",
            "k . h . s . h . k . k h s . h h",
