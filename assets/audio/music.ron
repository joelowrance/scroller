    // "Bank Up": original. The 1 -> 2 Cabinet Transition sting, about 4.5 s.
    // It starts on Cabinet 1's A minor drive, climbs through F and G as the
    // Wren banks and the view turns, and lands on a bright C major as
    // Cabinet 2's colours arrive. Plays once.
    BankUp: (
        bpm: 160,
        rows_per_beat: 4,
        looping: false,
        channels: [
            // Lead
            (instrument: (wave: Square(duty: 0.25), volume: 0.21,
                          env: (attack: 0.005, decay: 0.12, sustain: 0.6, release: 0.30),
                          vibrato: (depth: 0.2, rate: 6.0))),
            // Arpeggio
            (instrument: (wave: Square(duty: 0.125), volume: 0.09,
                          env: (decay: 0.06, sustain: 0.35, release: 0.30))),
            // Bass
            (instrument: (wave: Triangle, volume: 0.31,
                          env: (decay: 0.1, sustain: 0.7, release: 0.30))),
            // Drums
            (kit: {
