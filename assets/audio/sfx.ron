// Sound effects, rendered by src/audio/synth.rs at start-up. The names are the
// `Sfx` enum in src/audio/mod.rs, which says when each one plays.
//
// Each sound is a list of tones. A tone's fields (all optional):
//   at:      start time in seconds (for multi-note sounds)
//   wave:    Square(duty: 0.125 | 0.25 | 0.5), Triangle or Noise
//   freq:    starting pitch in Hz (for Noise, the noise clock rate)
//   gate:    seconds the note is held before its release
//   env:     (attack, decay, sustain, release) – seconds, sustain is a 0–1 level
//   slide:   pitch change over the gate, in semitones
//   vibrato: (depth: semitones, rate: Hz)
//   volume:  0–1
{
    // ---------------------------------------------------------------- Everywhere
    MenuMove: [
        (wave: Square(duty: 0.5), freq: 1760, gate: 0.025,
         env: (release: 0.015), volume: 0.20),
    ],
    MenuSelect: [
        (at: 0.00, wave: Square(duty: 0.25), freq: 1175, gate: 0.04, volume: 0.25),   // D6
        (at: 0.05, wave: Square(duty: 0.25), freq: 1760, gate: 0.07, volume: 0.25,
         env: (release: 0.05)),                                                       // A6
    ],
    // A long falling whine over a crunch.
    LifeLost: [
        (wave: Square(duty: 0.5), freq: 880, gate: 0.7, slide: -36,
         vibrato: (depth: 0.6, rate: 14.0),
         env: (decay: 0.7, sustain: 0.0, release: 0.05), volume: 0.30),
        (wave: Noise, freq: 2400, gate: 0.5, slide: -24,
         env: (decay: 0.5, sustain: 0.0, release: 0.05), volume: 0.40),
    ],
    ExtraLife: [
        (at: 0.00, wave: Square(duty: 0.25), freq: 523, gate: 0.08, volume: 0.30),    // C5
        (at: 0.09, wave: Square(duty: 0.25), freq: 659, gate: 0.08, volume: 0.30),    // E5
        (at: 0.18, wave: Square(duty: 0.25), freq: 784, gate: 0.08, volume: 0.30),    // G5
        (at: 0.27, wave: Square(duty: 0.25), freq: 1047, gate: 0.30, volume: 0.30,
         vibrato: (depth: 0.25, rate: 9.0), env: (release: 0.15)),                     // C6
        (at: 0.27, wave: Triangle, freq: 262, gate: 0.30, volume: 0.35,
         env: (release: 0.15)),                                                       // C4
    ],

    // ---------------------------------------------------------------- The Wren
    // Plays up to 10 times a second: a short, quiet tick.
    Shot: [
        (wave: Square(duty: 0.125), freq: 1900, gate: 0.03, slide: -12,
         env: (decay: 0.03, sustain: 0.0, release: 0.005), volume: 0.12),
    ],
    // Gun level 4: lower and thicker than the tick.
    Lance: [
        (wave: Square(duty: 0.25), freq: 1100, gate: 0.045, slide: -14,
         env: (decay: 0.045, sustain: 0.0, release: 0.005), volume: 0.14),
        (wave: Noise, freq: 9000, gate: 0.02,
         env: (decay: 0.02, sustain: 0.0, release: 0.005), volume: 0.06),
    ],
    // The Undertow: a deep thump, then a whoosh sweeping up as the ring grows.
    Undertow: [
        (wave: Triangle, freq: 70, gate: 0.35, slide: 12,
         env: (decay: 0.35, sustain: 0.0, release: 0.05), volume: 0.50),
        (wave: Noise, freq: 600, gate: 0.8, slide: 30,
         env: (attack: 0.05, decay: 0.75, sustain: 0.0, release: 0.1), volume: 0.35),
        (wave: Square(duty: 0.5), freq: 220, gate: 0.6, slide: 24,
         vibrato: (depth: 0.3, rate: 20.0),
         env: (decay: 0.6, sustain: 0.0, release: 0.05), volume: 0.12),
    ],
    // Power-ups: the same E5–B5 rise, each ending on its own top note.
    PowerUpGun: [
        (at: 0.00, wave: Square(duty: 0.25), freq: 659, gate: 0.04, volume: 0.25),
        (at: 0.04, wave: Square(duty: 0.25), freq: 988, gate: 0.04, volume: 0.25),
        (at: 0.08, wave: Square(duty: 0.25), freq: 1319, gate: 0.10, volume: 0.25,
         vibrato: (depth: 0.2, rate: 12.0), env: (release: 0.08)),                    // E6
    ],
    PowerUpDrone: [
        (at: 0.00, wave: Square(duty: 0.25), freq: 659, gate: 0.04, volume: 0.25),
        (at: 0.04, wave: Square(duty: 0.25), freq: 988, gate: 0.04, volume: 0.25),
        (at: 0.08, wave: Square(duty: 0.25), freq: 1568, gate: 0.10, volume: 0.25,
         vibrato: (depth: 0.2, rate: 12.0), env: (release: 0.08)),                    // G6
    ],
    PowerUpTail: [
        (at: 0.00, wave: Square(duty: 0.25), freq: 659, gate: 0.04, volume: 0.25),
        (at: 0.04, wave: Square(duty: 0.25), freq: 988, gate: 0.04, volume: 0.25),
        (at: 0.08, wave: Square(duty: 0.25), freq: 1175, gate: 0.10, volume: 0.25,
         vibrato: (depth: 0.2, rate: 12.0), env: (release: 0.08)),                    // D6
    ],
    PowerUpSpeed: [
        (at: 0.00, wave: Square(duty: 0.25), freq: 659, gate: 0.04, volume: 0.25),
        (at: 0.04, wave: Square(duty: 0.25), freq: 988, gate: 0.04, volume: 0.25),
        (at: 0.08, wave: Square(duty: 0.25), freq: 1760, gate: 0.10, volume: 0.25,
         vibrato: (depth: 0.2, rate: 12.0), env: (release: 0.08)),                    // A6
    ],
    PowerUpWard: [
        (at: 0.00, wave: Square(duty: 0.25), freq: 659, gate: 0.04, volume: 0.25),
        (at: 0.04, wave: Square(duty: 0.25), freq: 988, gate: 0.04, volume: 0.25),
        (at: 0.08, wave: Square(duty: 0.25), freq: 1976, gate: 0.10, volume: 0.25,
         vibrato: (depth: 0.2, rate: 12.0), env: (release: 0.08)),                    // B6
    ],
    PowerUpBomb: [
        (at: 0.00, wave: Square(duty: 0.25), freq: 659, gate: 0.04, volume: 0.25),
        (at: 0.04, wave: Square(duty: 0.25), freq: 988, gate: 0.04, volume: 0.25),
        (at: 0.08, wave: Square(duty: 0.25), freq: 1047, gate: 0.10, volume: 0.25,
         vibrato: (depth: 0.2, rate: 12.0), env: (release: 0.08)),                    // C6
        (at: 0.08, wave: Triangle, freq: 131, gate: 0.10, volume: 0.30,
         env: (release: 0.08)),                                                       // C3
    ],
    // A Power-up already at its maximum: a bright two-note coin.
    Medal: [
        (at: 0.00, wave: Square(duty: 0.5), freq: 1976, gate: 0.05, volume: 0.22),   // B6
        (at: 0.05, wave: Square(duty: 0.5), freq: 2637, gate: 0.25, volume: 0.22,
         env: (decay: 0.25, sustain: 0.0, release: 0.05)),                           // E7
    ],
    // The Ward shatters: a glassy crack falling away.
    WardBreak: [
        (wave: Noise, freq: 12000, gate: 0.15, slide: -12,
         env: (decay: 0.15, sustain: 0.0, release: 0.03), volume: 0.35),
        (wave: Square(duty: 0.125), freq: 2400, gate: 0.25, slide: -24,
         vibrato: (depth: 0.5, rate: 25.0),
         env: (decay: 0.25, sustain: 0.0, release: 0.03), volume: 0.20),
    ],

    // ---------------------------------------------------------------- Enemies
    // A shot lands but doesn't kill: a tiny spark.
    EnemyHit: [
        (wave: Noise, freq: 10000, gate: 0.025,
         env: (decay: 0.025, sustain: 0.0, release: 0.005), volume: 0.12),
    ],
    ExplosionSmall: [
        (wave: Noise, freq: 3000, gate: 0.25, slide: -24,
         env: (decay: 0.25, sustain: 0.0, release: 0.03), volume: 0.35),
    ],
    ExplosionLarge: [
        (wave: Noise, freq: 2000, gate: 0.8, slide: -30,
         env: (decay: 0.8, sustain: 0.0, release: 0.1), volume: 0.45),
        (wave: Triangle, freq: 90, gate: 0.5, slide: -12,
         env: (decay: 0.5, sustain: 0.0, release: 0.05), volume: 0.45),
        (at: 0.15, wave: Noise, freq: 1200, gate: 0.6, slide: -24,
         env: (decay: 0.6, sustain: 0.0, release: 0.1), volume: 0.30),
    ],
    // Shots glancing off a closed Clam: a short metallic ping.
    ShellPing: [
        (wave: Square(duty: 0.5), freq: 2794, gate: 0.01,
         env: (release: 0.06), volume: 0.10),
        (wave: Triangle, freq: 4186, gate: 0.01,
         env: (release: 0.05), volume: 0.10),
    ],
    // The arc switches on: a buzzing hum, as long as the arc is live (1.2 s).
    ArcHum: [
        (wave: Square(duty: 0.5), freq: 98, gate: 1.15,
         vibrato: (depth: 0.4, rate: 30.0),
         env: (attack: 0.03, release: 0.05), volume: 0.12),
        (wave: Noise, freq: 400, gate: 1.15,
         env: (attack: 0.03, release: 0.05), volume: 0.05),
    ],
    // Two beeps while the chevron blinks (0.75 s), so a Hook behind is heard.
    HookWarning: [
        (at: 0.00, wave: Square(duty: 0.5), freq: 1480, gate: 0.07,
         env: (release: 0.02), volume: 0.20),
        (at: 0.20, wave: Square(duty: 0.5), freq: 1480, gate: 0.07,
         env: (release: 0.02), volume: 0.20),
    ],

    // ---------------------------------------------------------------- Cabinet 2
    // (docs/cabinets/2-vertical-shooter.md). Shots, lances, the medal, enemy
    // hits, explosions, sparks off shields (ShellPing), the Ward and lost
    // lives reuse Cabinet 1's sounds.
    // Power-ups new to Cabinet 2: the same rise, their own top notes.
    PowerUpPod: [
        (at: 0.00, wave: Square(duty: 0.25), freq: 659, gate: 0.04, volume: 0.25),
        (at: 0.04, wave: Square(duty: 0.25), freq: 988, gate: 0.04, volume: 0.25),
        (at: 0.08, wave: Square(duty: 0.25), freq: 1480, gate: 0.10, volume: 0.25,
         vibrato: (depth: 0.2, rate: 12.0), env: (release: 0.08)),                    // F#6
    ],
    PowerUpRockets: [
        (at: 0.00, wave: Square(duty: 0.25), freq: 659, gate: 0.04, volume: 0.25),
        (at: 0.04, wave: Square(duty: 0.25), freq: 988, gate: 0.04, volume: 0.25),
        (at: 0.08, wave: Square(duty: 0.25), freq: 1245, gate: 0.10, volume: 0.25,
         vibrato: (depth: 0.2, rate: 12.0), env: (release: 0.08)),                    // D#6
        (at: 0.08, wave: Noise, freq: 3000, gate: 0.10, slide: 12,
         env: (decay: 0.1, sustain: 0.0, release: 0.02), volume: 0.12),
    ],
    // Rockets launch twice a second: a soft hiss.
    RocketLaunch: [
        (wave: Noise, freq: 5000, gate: 0.12, slide: 7,
         env: (attack: 0.01, decay: 0.11, sustain: 0.0, release: 0.02), volume: 0.10),
    ],
    // The Squall: a low boom, then two sweeps (the edges) racing apart.
    Squall: [
        (wave: Triangle, freq: 65, gate: 0.3, slide: -5,
         env: (decay: 0.3, sustain: 0.0, release: 0.05), volume: 0.50),
        (wave: Noise, freq: 900, gate: 0.6, slide: 24,
         env: (attack: 0.03, decay: 0.57, sustain: 0.0, release: 0.08), volume: 0.30),
        (wave: Square(duty: 0.5), freq: 330, gate: 0.55, slide: 19,
         vibrato: (depth: 0.4, rate: 18.0),
         env: (decay: 0.55, sustain: 0.0, release: 0.05), volume: 0.10),
        (wave: Square(duty: 0.5), freq: 330, gate: 0.55, slide: -12,
         vibrato: (depth: 0.4, rate: 18.0),
         env: (decay: 0.55, sustain: 0.0, release: 0.05), volume: 0.10),
    ],
    // The chevron under a Swift: two low-high blips (Cabinet 1's Hook beeps
    // are flat; these rise, for "from below").
    SwiftWarning: [
        (at: 0.00, wave: Square(duty: 0.5), freq: 988, gate: 0.07, slide: 7,
         env: (release: 0.02), volume: 0.20),
        (at: 0.25, wave: Square(duty: 0.5), freq: 988, gate: 0.07, slide: 7,
         env: (release: 0.02), volume: 0.20),
    ],
    // A Flak Battery marks the Hero: a sharp targeting beep.
    FlakMark: [
        (wave: Square(duty: 0.25), freq: 2093, gate: 0.05,
         env: (release: 0.03), volume: 0.18),
        (at: 0.08, wave: Square(duty: 0.25), freq: 2093, gate: 0.05,
         env: (release: 0.03), volume: 0.18),
    ],
    // The shell bursts at the mark: a hard crack.
    FlakBurst: [
        (wave: Noise, freq: 6000, gate: 0.18, slide: -18,
         env: (decay: 0.18, sustain: 0.0, release: 0.03), volume: 0.45),
        (wave: Triangle, freq: 140, gate: 0.12, slide: -12,
         env: (decay: 0.12, sustain: 0.0, release: 0.02), volume: 0.30),
    ],
    // A Riser throws a pod: a thump, then a whistle rising over the 1 s climb.
    RiserLaunch: [
        (wave: Triangle, freq: 110, gate: 0.12, slide: -12,
         env: (decay: 0.12, sustain: 0.0, release: 0.02), volume: 0.45),
        (wave: Noise, freq: 1500, gate: 0.06,
         env: (decay: 0.06, sustain: 0.0, release: 0.01), volume: 0.20),
        (at: 0.05, wave: Square(duty: 0.5), freq: 700, gate: 0.95, slide: 19,
         vibrato: (depth: 0.15, rate: 10.0),
         env: (attack: 0.1, decay: 0.85, sustain: 0.3, release: 0.05), volume: 0.10),
    ],
    // A Loom's last shuttle goes: the shield shatters and the shuttles fall.
    LoomShieldBreak: [
        (wave: Noise, freq: 10000, gate: 0.2, slide: -12,
         env: (decay: 0.2, sustain: 0.0, release: 0.04), volume: 0.35),
        (wave: Square(duty: 0.125), freq: 1760, gate: 0.3, slide: -24,
         vibrato: (depth: 0.6, rate: 22.0),
         env: (decay: 0.3, sustain: 0.0, release: 0.04), volume: 0.18),
    ],
    // A destroyed shuttle falls away as wreckage: a long falling whine.
    ShuttleFall: [
        (wave: Square(duty: 0.25), freq: 1200, gate: 0.9, slide: -30,
         env: (decay: 0.9, sustain: 0.2, release: 0.05), volume: 0.12),
    ],
    // The Loom's spiral: a soft tick per volley (every 0.3 s).
    LoomTick: [
        (wave: Square(duty: 0.125), freq: 3136, gate: 0.01,
         env: (release: 0.02), volume: 0.08),
    ],
    // A Silo's hatch opening: a metal clank.
    SiloClank: [
        (wave: Square(duty: 0.5), freq: 180, gate: 0.05, slide: -5,
         env: (decay: 0.05, sustain: 0.0, release: 0.02), volume: 0.30),
        (wave: Noise, freq: 2500, gate: 0.04,
         env: (decay: 0.04, sustain: 0.0, release: 0.01), volume: 0.25),
        (at: 0.03, wave: Triangle, freq: 1568, gate: 0.01,
         env: (release: 0.08), volume: 0.15),
    ],
    // A Tether's line goes live (1.2 s): a thin, high hum, unlike the low
    // Arc Gate buzz.
    TetherHum: [
        (wave: Square(duty: 0.125), freq: 220, gate: 1.15,
         vibrato: (depth: 0.25, rate: 24.0),
         env: (attack: 0.03, release: 0.05), volume: 0.10),
        (wave: Noise, freq: 800, gate: 1.15,
         env: (attack: 0.03, release: 0.05), volume: 0.04),
    ],
    // The flak hit that ends Cabinet 2: the 2 -> 3 Transition's first sound.
    FinalHit: [
        (wave: Noise, freq: 4000, gate: 1.2, slide: -36,
         env: (decay: 1.2, sustain: 0.0, release: 0.2), volume: 0.50),
        (wave: Triangle, freq: 80, gate: 0.8, slide: -12,
         env: (decay: 0.8, sustain: 0.0, release: 0.1), volume: 0.50),
        (wave: Square(duty: 0.5), freq: 660, gate: 1.0, slide: -24,
         vibrato: (depth: 1.0, rate: 16.0),
         env: (decay: 1.0, sustain: 0.0, release: 0.1), volume: 0.18),
    ],

    // ---------------------------------------------------------------- Cabinet 3
    // docs/cabinets/3-run-and-gun.md. The shot (Shot), the bolt (Lance),
    // Power-ups G and W, the medal, hits, armour sparks (ShellPing),
    // explosions, the Ward, the behind chevron (HookWarning), lost lives and
    // the STAGE CLEAR sting reuse the sounds above.
    // A footstep: a soft scuff, every other run frame.
    Footstep: [
        (wave: Noise, freq: 1800, gate: 0.025,
         env: (decay: 0.025, sustain: 0.0, release: 0.005), volume: 0.07),
    ],
    // The jump: a quick rise.
    Jump: [
        (wave: Square(duty: 0.25), freq: 330, gate: 0.12, slide: 12,
         env: (decay: 0.12, sustain: 0.2, release: 0.02), volume: 0.16),
    ],
    // The Jet's mid-air jump: a puff of air and a higher rise.
    JetPuff: [
        (wave: Noise, freq: 5000, gate: 0.12, slide: -12,
         env: (decay: 0.12, sustain: 0.0, release: 0.02), volume: 0.16),
        (wave: Square(duty: 0.125), freq: 523, gate: 0.10, slide: 10,
         env: (decay: 0.10, sustain: 0.1, release: 0.02), volume: 0.10),
    ],
    // Landing: a low thump.
    Land: [
        (wave: Triangle, freq: 110, gate: 0.06, slide: -10,
         env: (decay: 0.06, sustain: 0.0, release: 0.01), volume: 0.30),
        (wave: Noise, freq: 1200, gate: 0.03,
         env: (decay: 0.03, sustain: 0.0, release: 0.01), volume: 0.06),
    ],
    // A flare is lobbed: a soft whump with a short whistle up.
    FlareLob: [
        (wave: Triangle, freq: 220, gate: 0.05, slide: -5,
         env: (decay: 0.05, sustain: 0.0, release: 0.01), volume: 0.22),
        (wave: Square(duty: 0.125), freq: 1400, gate: 0.15, slide: 5,
         env: (attack: 0.02, decay: 0.13, sustain: 0.0, release: 0.02), volume: 0.06),
    ],
    // A flare bursts: a bright crackle with a little body.
    FlareBurst: [
        (wave: Noise, freq: 9000, gate: 0.18, slide: -18,
         env: (decay: 0.18, sustain: 0.0, release: 0.03), volume: 0.24),
        (wave: Triangle, freq: 150, gate: 0.10, slide: -12,
         env: (decay: 0.10, sustain: 0.0, release: 0.01), volume: 0.22),
    ],
    PowerUpFlare: [
        (at: 0.00, wave: Square(duty: 0.25), freq: 659, gate: 0.04, volume: 0.25),
        (at: 0.04, wave: Square(duty: 0.25), freq: 988, gate: 0.04, volume: 0.25),
        (at: 0.08, wave: Square(duty: 0.25), freq: 1397, gate: 0.10, volume: 0.25,
         vibrato: (depth: 0.2, rate: 12.0), env: (release: 0.08)),                    // F6
    ],
    PowerUpJet: [
        (at: 0.00, wave: Square(duty: 0.25), freq: 659, gate: 0.04, volume: 0.25),
        (at: 0.04, wave: Square(duty: 0.25), freq: 988, gate: 0.04, volume: 0.25),
        (at: 0.08, wave: Square(duty: 0.25), freq: 1661, gate: 0.10, volume: 0.25,
         vibrato: (depth: 0.2, rate: 12.0), env: (release: 0.08)),                    // G#6
    ],
    PowerUpHustle: [
        (at: 0.00, wave: Square(duty: 0.25), freq: 659, gate: 0.04, volume: 0.25),
        (at: 0.04, wave: Square(duty: 0.25), freq: 988, gate: 0.04, volume: 0.25),
        (at: 0.08, wave: Square(duty: 0.25), freq: 1865, gate: 0.10, volume: 0.25,
         vibrato: (depth: 0.2, rate: 12.0), env: (release: 0.08)),                    // Bb6
    ],
    // A Sentry rises out of its pit: a grinding climb.
    SentryRise: [
        (wave: Square(duty: 0.125), freq: 110, gate: 0.5, slide: 12,
         vibrato: (depth: 0.5, rate: 25.0),
         env: (attack: 0.05, sustain: 0.8, release: 0.05), volume: 0.12),
    ],
    // A Burrower's dust before it bites: a low rumbling hiss.
    BurrowerDust: [
        (wave: Noise, freq: 700, gate: 0.5,
         env: (attack: 0.15, decay: 0.35, sustain: 0.0, release: 0.05), volume: 0.18),
        (wave: Triangle, freq: 55, gate: 0.5,
         vibrato: (depth: 1.0, rate: 14.0),
         env: (attack: 0.1, sustain: 0.8, release: 0.05), volume: 0.22),
    ],
    // A Dropper's hatch opens: two metal clicks.
    DropperHatch: [
        (at: 0.00, wave: Square(duty: 0.5), freq: 660, gate: 0.02,
