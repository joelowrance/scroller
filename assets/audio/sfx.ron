         env: (attack: 0.05, sustain: 0.8, release: 0.03), volume: 0.12),
        (wave: Square(duty: 0.5), freq: 120, gate: 0.4,
         vibrato: (depth: 0.5, rate: 40.0),
         env: (attack: 0.3, sustain: 1.0, release: 0.03), volume: 0.08),
    ],
    // A conveyor on screen: a low hum (sent about once a second).
    ConveyorHum: [
        (wave: Square(duty: 0.25), freq: 65, gate: 0.9,
         vibrato: (depth: 0.2, rate: 8.0),
         env: (attack: 0.1, sustain: 0.8, release: 0.1), volume: 0.06),
    ],
    // A crumbling ledge starts to shake: a dry creak.
    LedgeCreak: [
        (wave: Square(duty: 0.125), freq: 180, gate: 0.4, slide: -5,
         vibrato: (depth: 1.5, rate: 18.0),
         env: (attack: 0.03, sustain: 0.6, release: 0.05), volume: 0.12),
        (wave: Noise, freq: 1500, gate: 0.4,
         env: (attack: 0.2, decay: 0.2, sustain: 0.0, release: 0.05), volume: 0.10),
    ],
    // The Strider's foot comes down.
    StriderStomp: [
        (wave: Triangle, freq: 55, gate: 0.35, slide: -12,
         env: (decay: 0.35, sustain: 0.0, release: 0.05), volume: 0.50),
        (wave: Noise, freq: 1000, gate: 0.2,
         env: (decay: 0.2, sustain: 0.0, release: 0.03), volume: 0.20),
    ],
    // The shockwave rolls out along the ground.
    StriderShockwave: [
        (wave: Noise, freq: 600, gate: 0.6, slide: 12,
         env: (decay: 0.6, sustain: 0.0, release: 0.05), volume: 0.20),
        (wave: Square(duty: 0.5), freq: 90, gate: 0.5, slide: -5,
         vibrato: (depth: 0.5, rate: 20.0),
         env: (decay: 0.5, sustain: 0.0, release: 0.05), volume: 0.10),
    ],
    // The Standoff locks in as the scroll stops: two low, hard notes.
    StandoffLock: [
        (at: 0.00, wave: Square(duty: 0.5), freq: 147, gate: 0.10,
         env: (release: 0.02), volume: 0.20),                                         // D3
        (at: 0.00, wave: Noise, freq: 3000, gate: 0.05,
         env: (decay: 0.05, sustain: 0.0, release: 0.01), volume: 0.12),
        (at: 0.16, wave: Square(duty: 0.5), freq: 139, gate: 0.30,
         env: (decay: 0.3, sustain: 0.3, release: 0.05), volume: 0.20),               // C#3
        (at: 0.16, wave: Triangle, freq: 69, gate: 0.30,
         env: (decay: 0.3, sustain: 0.3, release: 0.05), volume: 0.30),
    ],
    // The Standoff is cleared and the scroll resumes: a bright rise.
    StandoffRelease: [
        (at: 0.00, wave: Square(duty: 0.25), freq: 587, gate: 0.06, volume: 0.20),   // D5
        (at: 0.06, wave: Square(duty: 0.25), freq: 740, gate: 0.06, volume: 0.20),   // F#5
        (at: 0.12, wave: Square(duty: 0.25), freq: 880, gate: 0.06, volume: 0.20),   // A5
        (at: 0.18, wave: Square(duty: 0.25), freq: 1175, gate: 0.20, volume: 0.20,
         vibrato: (depth: 0.2, rate: 10.0), env: (release: 0.08)),                    // D6
    ],
    // A fall into a pit: a long falling whistle (LifeLost follows).
    FallWhistle: [
        (wave: Square(duty: 0.5), freq: 1600, gate: 0.8, slide: -30,
         env: (attack: 0.02, sustain: 0.9, release: 0.05), volume: 0.14),
    ],
}
