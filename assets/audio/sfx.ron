        (at: 0.08, wave: Noise, freq: 6000, gate: 0.03,
         env: (decay: 0.03, sustain: 0.0, release: 0.01), volume: 0.08),
    ],
    // The Strider lifts a leg: hydraulics straining upward.
    StriderLegLift: [
        (wave: Noise, freq: 2500, gate: 0.4, slide: 12,
         env: (attack: 0.1, sustain: 0.6, release: 0.05), volume: 0.12),
        (wave: Square(duty: 0.25), freq: 82, gate: 0.4, slide: 7,
         env: (attack: 0.05, sustain: 0.7, release: 0.05), volume: 0.12),
    ],
    // A Crusher slams down: a heavy boom with a clank on top.
    CrusherSlam: [
        (wave: Triangle, freq: 70, gate: 0.25, slide: -12,
         env: (decay: 0.25, sustain: 0.0, release: 0.03), volume: 0.45),
