// Stand-in Stage for Cabinet 2 (both Stages) until #15 writes 2-1.ron and
// 2-2.ron: about a minute of sky with a few Formations to shoot.
// Positions are canvas pixels from the centre; `at` is the scroll position.
// The Wren always flies in to vertical_shooter.hero.start.
(
    length: 1600.0,
    speed: [(from: 0.0, speed: 26.0)],
    restart_points: [(at: 0.0, hero: (0.0, -80.0)), (at: 800.0, hero: (0.0, -80.0))],
    spawns: [
        (at: 60.0, kind: "wisp", pos: (0.0, 124.0), params: {"drop": "G"}),
        (at: 220.0, kind: "wisp", pos: (-80.0, 124.0), params: {"drop": "P"}),
        (at: 380.0, kind: "crawler", pos: (-150.0, 128.0), params: {"heading": 0.0, "drop": "R"}),
        (at: 560.0, kind: "bellows", pos: (100.0, 60.0)),
        (at: 760.0, kind: "silo", pos: (-60.0, 130.0)),
        (at: 760.0, kind: "silo", pos: (60.0, 130.0)),
        (at: 920.0, kind: "riser", pos: (0.0, 130.0)),
        (at: 1100.0, kind: "swift", pos: (0.0, 0.0)),
        (at: 1240.0, kind: "wisp", pos: (60.0, 124.0), params: {"drop": "B"}),
    ],
)
